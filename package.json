{
  "name": "calculatrade-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down -v"
  }
}
